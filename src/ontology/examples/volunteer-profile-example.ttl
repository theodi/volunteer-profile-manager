# Example Volunteer Profile
# Demonstrates usage of the Volunteer Profile Ontology
# Stored in a Solid pod as an extended profile document

@prefix vp:              <https://id.volunteeringdata.io/volunteer-profile/> .
@prefix volunteering:    <https://id.volunteeringdata.io/schema/> .
@prefix rdf:             <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .
@prefix :                <#> .


## ============================================================================
## Volunteer Profile
## ============================================================================

:volunteerProfile
    a vp:VolunteerProfile ;
    
    # Location preferences
    vp:preferredLocation :locationLondon ;
    vp:preferredLocation :locationBirmingham ;
    
    # Time preferences
    vp:preferredTime :saturdayMorning ;
    vp:preferredTime :wednesdayEvening ;
    
    # Skills (from CrisisResponseSkills in crisis.ttl)
    vp:hasSkill volunteering:ActiveListening ;
    vp:hasSkill volunteering:CalmnessUnderPressure ;
    vp:hasSkill volunteering:Driving ;
    vp:hasSkill volunteering:BasicFirstAidKnowledge ;
    
    # Requirements/Assets (from CrisisResponseRequirement in crisis.ttl)
    vp:hasRequirement volunteering:PhysicalStamina ;
    vp:hasRequirement volunteering:SturdyFootwear ;
    vp:hasRequirement volunteering:HighVisibilityVest ;
    vp:hasRequirement volunteering:PhoneAndPowerBank ;
    
    # Preferred charitable causes (from Cause in vocabulary.ttl)
    vp:preferredCause <https://id.volunteeringdata.io/concept/cause/environment> ;
    vp:preferredCause <https://id.volunteeringdata.io/concept/cause/community> ;
.


## ============================================================================
## Location Preferences
## ============================================================================

:locationLondon
    a vp:PreferredLocation ;
    vp:long "-0.1278"^^xsd:decimal ;
    vp:lat "51.5074"^^xsd:decimal ;
    vp:rad "15"^^xsd:decimal ;
.

:locationBirmingham
    a vp:PreferredLocation ;
    vp:long "-1.8904"^^xsd:decimal ;
    vp:lat "52.4862"^^xsd:decimal ;
    vp:rad "10"^^xsd:decimal ;
.


## ============================================================================
## Time Preferences
## ============================================================================

:saturdayMorning
    a vp:PreferredTime ;
    vp:day vp:Saturday ;
    vp:time vp:Morning ;
.

:wednesdayEvening
    a vp:PreferredTime ;
    vp:day vp:Wednesday ;
    vp:time vp:Evening ;
.
