## VolunteerProfile Shape
vps:VolunteerProfileShape
    a sh:NodeShape ;
    sh:targetClass vp:VolunteerProfile ;
    sh:closed true ;
    rdfs:label "Volunteer Profile"@en ;
    rdfs:comment """A volunteer profile document containing location preferences, time preferences, skills, requirements, and charitable cause interests. This is an extended profile document separate from the WebID profile."""@en ;
    sh:ignoredProperties ( rdf:type vp:long vp:lat vp:rad vp:day vp:time ) ;
    sh:property [
        sh:path vp:preferredLocation ;
        sh:class vp:PreferredLocation ;
        sh:name "preferred location" ;
        sh:description """A location where the volunteer prefers to participate in volunteering activities.""" ;
    ] ;
    sh:property [
        sh:path vp:preferredTime ;
        sh:class vp:PreferredTime ;
        sh:name "preferred time" ;
        sh:description """A time preference indicating when the volunteer is available.""" ;
    ] ;
    sh:property [
        sh:path vp:hasSkill ;
        sh:class volunteering:CrisisResponseSkills ;
        sh:name "has skill" ;
        sh:description """A crisis response skill that the volunteer possesses.""" ;
    ] ;
    sh:property [
        sh:path vp:hasRequirement ;
        sh:class volunteering:CrisisResponseRequirement ;
        sh:name "has requirement" ;
        sh:description """A crisis response requirement that the volunteer can fulfill (e.g., equipment, physical readiness).""" ;
    ] ;
    sh:property [
        sh:path vp:preferredCause ;
        sh:class volunteering:Cause ;
        sh:name "preferred cause" ;
        sh:description """A charitable cause that the volunteer is interested in supporting.""" ;
    ] ;
.

## PreferredLocation Shape
vps:PreferredLocationShape
    a sh:NodeShape ;
    sh:targetClass vp:PreferredLocation ;
    sh:closed true ;
    rdfs:label "Preferred Location"@en ;
    rdfs:comment """A geographic location preference defined by coordinates and a search radius."""@en ;
    sh:ignoredProperties ( rdf:type vp:preferredLocation vp:preferredTime vp:hasSkill vp:hasRequirement vp:preferredCause vp:day vp:time ) ;
    sh:property [
        sh:path vp:long ;
        sh:datatype xsd:decimal ;
        sh:name "longitude" ;
        sh:description """The longitude coordinate of the preferred location.""" ;
    ] ;
    sh:property [
        sh:path vp:lat ;
        sh:datatype xsd:decimal ;
        sh:name "latitude" ;
        sh:description """The latitude coordinate of the preferred location.""" ;
    ] ;
    sh:property [
        sh:path vp:rad ;
        sh:datatype xsd:decimal ;
        sh:name "radius" ;
        sh:description """The radius (in kilometers) around the location coordinates within which the volunteer is willing to participate.""" ;
    ] ;
.

## PreferredTime Shape
vps:PreferredTimeShape
    a sh:NodeShape ;
    sh:targetClass vp:PreferredTime ;
    sh:closed true ;
    rdfs:label "Preferred Time"@en ;
    rdfs:comment """A time preference indicating day of week and time of day."""@en ;
    sh:ignoredProperties ( rdf:type vp:preferredLocation vp:preferredTime vp:hasSkill vp:hasRequirement vp:preferredCause vp:long vp:lat vp:rad ) ;
    sh:property [
        sh:path vp:day ;
        sh:class vp:DayOfWeek ;
        sh:name "day" ;
        sh:description """The day of the week for this time preference.""" ;
    ] ;
    sh:property [
        sh:path vp:time ;
        sh:class vp:TimeOfDay ;
        sh:name "time" ;
        sh:description """The time period of the day (Morning, Afternoon, or Evening).""" ;
    ] ;
.

