# Volunteer Profile SHACL Shapes
# Validates volunteer profile data conformant to the Volunteer Profile Ontology
# For use with Solid applications
#
# Reuses standard vocabularies:
# - W3C Time Ontology for days of the week (time:Monday, etc.)
# - Custom vp:TimeOfDay for time of day (vp:Morning, vp:Afternoon, vp:Evening)

@prefix sh:              <http://www.w3.org/ns/shacl#> .
@prefix vp:              <https://id.volunteeringdata.io/volunteer-profile/> .
@prefix vps:             <https://id.volunteeringdata.io/volunteer-profile/shapes/> .
@prefix volunteering:    <https://id.volunteeringdata.io/schema/> .
@prefix rdf:             <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:             <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix time:            <http://www.w3.org/2006/time#> .


## ============================================================================
## Volunteer Profile Shape
## ============================================================================

vps:VolunteerProfileShape
    a sh:NodeShape ;
    sh:targetClass vp:VolunteerProfile ;
    rdfs:label "Volunteer Profile Shape"@en ;
    rdfs:comment "Validates a volunteer profile document."@en ;

    # Location preferences
    sh:property [
        sh:path vp:preferredLocation ;
        sh:node vps:PreferredLocationShape ;
        sh:name "preferred location" ;
        sh:description "Locations where the volunteer prefers to help." ;
    ] ;

    # Time preferences
    sh:property [
        sh:path vp:preferredTime ;
        sh:node vps:PreferredTimeShape ;
        sh:name "preferred time" ;
        sh:description "Times when the volunteer prefers to help." ;
    ] ;

    # Skills (range: CrisisResponseSkills from crisis.ttl)
    sh:property [
        sh:path vp:hasSkill ;
        sh:node vps:CrisisResponseSkillsShape ;
        sh:name "has skill" ;
        sh:description "Crisis response skills the volunteer possesses." ;
    ] ;

    # Requirements (range: CrisisResponseRequirement from crisis.ttl)
    sh:property [
        sh:path vp:hasRequirement ;
        sh:node vps:CrisisResponseRequirementShape ;
        sh:name "has requirement" ;
        sh:description "Crisis response requirements the volunteer can fulfill." ;
    ] ;

    # Preferred causes (range: Cause from vocabulary.ttl)
    sh:property [
        sh:path vp:preferredCause ;
        sh:node vps:CauseShape ;
        sh:name "preferred cause" ;
        sh:description "Charitable causes the volunteer is interested in." ;
    ] ;
.


## ============================================================================
## Preferred Location Shape
## ============================================================================

vps:PreferredLocationShape
    a sh:NodeShape ;
    sh:targetClass vp:PreferredLocation ;
    rdfs:label "Preferred Location Shape"@en ;
    rdfs:comment "Validates a location preference with coordinates and radius."@en ;

    # Longitude - using vp:long (equivalent to geo:long)
    sh:property [
        sh:path vp:long ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -180 ;
        sh:maxInclusive 180 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "longitude" ;
        sh:description "Longitude coordinate of the preferred location (WGS84)." ;
    ] ;

    # Latitude - using vp:lat (equivalent to geo:lat)
    sh:property [
        sh:path vp:lat ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -90 ;
        sh:maxInclusive 90 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "latitude" ;
        sh:description "Latitude coordinate of the preferred location (WGS84)." ;
    ] ;

    # Radius - custom property for search area
    sh:property [
        sh:path vp:rad ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "radius" ;
        sh:description "Search radius in kilometers from the location." ;
    ] ;
.


## ============================================================================
## Preferred Time Shape
## ============================================================================

vps:PreferredTimeShape
    a sh:NodeShape ;
    sh:targetClass vp:PreferredTime ;
    rdfs:label "Preferred Time Shape"@en ;
    rdfs:comment "Validates a time preference with day of week and time of day."@en ;

    # Day of week - reuses W3C Time Ontology individuals
    sh:property [
        sh:path vp:day ;
        sh:in (
            time:Monday
            time:Tuesday
            time:Wednesday
            time:Thursday
            time:Friday
            time:Saturday
            time:Sunday
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "day" ;
        sh:description "The day of the week (from W3C Time Ontology)." ;
    ] ;

    # Time of day - uses custom vp:TimeOfDay individuals
    # (skos:relatedMatch to NCIT: ncit:C64934 Morning, ncit:C64935 Afternoon, ncit:C64936 Evening)
    sh:property [
        sh:path vp:time ;
        sh:in (
            vp:Morning
            vp:Afternoon
            vp:Evening
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "time of day" ;
        sh:description "The time period of the day: Morning, Afternoon, or Evening." ;
    ] ;
.


## ============================================================================
## Crisis Response Skills Shape
## ============================================================================
## Values from https://github.com/volunteeringdata/volunteering-data-model/blob/main/hackathon/crisis-response-and-spontaneous-volunteering/crisis.ttl

vps:CrisisResponseSkillsShape
    a sh:NodeShape ;
    sh:targetClass volunteering:CrisisResponseSkills ;
    rdfs:label "Crisis Response Skills Shape"@en ;
    rdfs:comment "Validates crisis response skills values."@en ;
    sh:in (
        # Personal and Interpersonal Skills
        volunteering:EmpathyAndCompassion
        volunteering:CalmnessUnderPressure
        volunteering:PatienceAndUnderstanding
        volunteering:ReliabilityAndTrustworthiness
        volunteering:RespectForProfessionalBoundaries
        volunteering:CulturalSensitivity
        volunteering:TraumaInformedAwareness
        volunteering:ConflictDeescalation
        # Communication Skills
        volunteering:ClearSpokenCommunication
        volunteering:ActiveListening
        volunteering:AbilityToRelayAccurateInformation
        volunteering:SupportingPeopleViaPhoneOnline
        volunteering:UseOfRadiosAndWalkieTalkies
        volunteering:ConfidenceEngagingWithPublicOrGroups
        # Teamwork and Leadership Skills
        volunteering:AbilityToWorkCooperatively
        volunteering:AbilityToWorkIndependently
        volunteering:LeadingSmallGroupsOrTasks
        volunteering:ManagingConflictWithinTeams
        volunteering:SupportingOrMentoringNewVolunteers
        # Safety and Emergency Awareness Skills
        volunteering:UnderstandingEmergencyBriefingsAndInstructions
        volunteering:BasicSafeguardingKnowledge
        volunteering:RiskAwareness
        volunteering:SafeManualHandling
        volunteering:IncidentReporting
        volunteering:BasicFirstAidKnowledge
        volunteering:FireSafetyAwareness
        volunteering:WaterSafetyAwareness
        # Practical and Operational Skills
        volunteering:Logistics
        volunteering:ShelterSupport
        volunteering:BasicRecordKeeping
        volunteering:UseOfBasicEquipment
        volunteering:NavigationAndOrientation
        volunteering:Driving
        volunteering:CrowdQueueManagement
        volunteering:PilotLicense
        volunteering:HGVCategoryD
        # Digital and Technology Skills
        volunteering:BasicITSkills
        volunteering:ConfidentSmartphoneUse
        volunteering:FamiliarityWithRemoteCommunicationTools
        volunteering:SimpleDataEntryAndReporting
        volunteering:ResponsibleHandlingOfSocialMedia
        # Community Skills
        volunteering:KnowledgeOfLocalRoadsFacilitiesResources
        volunteering:UnderstandingDiverseNeedsWithinCommunity
        volunteering:AwarenessOfLocalSupportServices
    ) ;
.


## ============================================================================
## Crisis Response Requirement Shape
## ============================================================================
## Values from https://github.com/volunteeringdata/volunteering-data-model/blob/main/hackathon/crisis-response-and-spontaneous-volunteering/crisis.ttl

vps:CrisisResponseRequirementShape
    a sh:NodeShape ;
    sh:targetClass volunteering:CrisisResponseRequirement ;
    rdfs:label "Crisis Response Requirement Shape"@en ;
    rdfs:comment "Validates crisis response requirement values."@en ;
    sh:in (
        # Physical and Practical Readiness
        volunteering:PhysicalStamina
        volunteering:AbilityToWorkOutdoors
        volunteering:PersonalPreparedness
        # Assets and Equipment
        volunteering:SturdyFootwear
        volunteering:WaterproofsAndWarmLayers
        volunteering:Gloves
        volunteering:HighVisibilityVest
        volunteering:HeadtorchOrFlashlight
        volunteering:PhoneAndPowerBank
        volunteering:SmallPersonalFirstAidKit
        volunteering:WaterBottle
        volunteering:FourByFourVehicle
        volunteering:SUVOrOffRoadVehicle
        volunteering:VehicleWithTowCapability
        volunteering:AccessToVanOrPeopleCarrier
        volunteering:AbilityToTransportEquipmentOrSupplies
        volunteering:AccessToBicyclesOrCargoBikes
        volunteering:Boat
        volunteering:Hovercraft
        volunteering:WalkieTalkiesOrRadios
        volunteering:PortableGeneratorOrPowerStation
        volunteering:WaterPump
        volunteering:Tools
        volunteering:PortableShelterOrGazebo
        volunteering:ThermalBlankets
        volunteering:PPE
        volunteering:MapsOrWaterproofMapCases
        volunteering:LifeJacket
        volunteering:Venue
        volunteering:Kitchen
    ) ;
.


## ============================================================================
## Cause Shape
## ============================================================================
## Note: The Cause class is defined in the volunteering vocabulary but specific
## cause individuals are not enumerated in the ontology. This shape validates
## that the value is of type volunteering:Cause. Applications should populate
## cause values from the vocabulary service or define application-specific causes.

vps:CauseShape
    a sh:NodeShape ;
    sh:targetClass volunteering:Cause ;
    rdfs:label "Cause Shape"@en ;
    rdfs:comment "Validates charitable cause values. Causes are instances of volunteering:Cause from the Volunteering Data Model vocabulary."@en ;
.
